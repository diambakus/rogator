<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ================================================================= -->
    <!-- CHANGESET 1 - CREATE SEQUENCE                                     -->
    <!-- ================================================================= -->

    <changeSet id="1-create-app-form-seq"
               author="adruida">

        <preConditions onFail="MARK_RAN">

            <not>
                <sequenceExists
                        sequenceName="app_form_seq"
                        schemaName="${schemaName}"/>
            </not>

        </preConditions>

        <createSequence
                sequenceName="app_form_seq"
                schemaName="${schemaName}"
                startValue="1"
                incrementBy="1"/>

    </changeSet>

    <!-- ================================================================= -->
    <!-- CHANGESET 2 - CREATE TABLE                                        -->
    <!-- ================================================================= -->

    <changeSet id="2-create-application-forms-table"
               author="adruida">

        <preConditions onFail="MARK_RAN">

            <not>
                <tableExists
                        tableName="application_forms"
                        schemaName="${schemaName}"/>
            </not>

        </preConditions>

        <createTable
                tableName="application_forms"
                schemaName="${schemaName}">

            <column name="id"
                    type="BIGINT"
                    autoIncrement="true">

                <constraints
                        primaryKey="true"
                        nullable="false"/>

            </column>

            <column name="application_id"
                    type="BIGINT">

                <constraints nullable="false"/>

            </column>

            <column name="position"
                    type="INTEGER"/>

            <column name="name"
                    type="VARCHAR(255)"/>

            <!-- ========================================================= -->
            <!-- PostgreSQL-native JSONB                                  -->
            <!-- ========================================================= -->

            <column name="content"
                    type="jsonb"/>

            <column name="created"
                    type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>

        </createTable>

    </changeSet>

    <!-- ================================================================= -->
    <!-- CHANGESET 3 - FOREIGN KEY                                         -->
    <!-- ================================================================= -->

    <changeSet id="3-add-app-form-application-fk"
               author="adruida">

        <preConditions onFail="MARK_RAN">

            <tableExists
                    tableName="application_forms"
                    schemaName="${schemaName}"/>

            <tableExists
                    tableName="applications"
                    schemaName="${schemaName}"/>

            <columnExists
                    tableName="application_forms"
                    schemaName="${schemaName}"
                    columnName="application_id"/>

            <not>
                <foreignKeyConstraintExists
                        foreignKeyName="fk_app_form_application"/>
            </not>

        </preConditions>

        <addForeignKeyConstraint
                baseTableSchemaName="${schemaName}"
                baseTableName="application_forms"
                baseColumnNames="application_id"

                referencedTableSchemaName="${schemaName}"
                referencedTableName="applications"
                referencedColumnNames="id"

                constraintName="fk_app_form_application"

                onDelete="CASCADE"
                onUpdate="RESTRICT"/>

    </changeSet>

    <!-- ================================================================= -->
    <!-- CHANGESET 4 - INDEX application_id                                -->
    <!-- ================================================================= -->

    <changeSet id="4-create-app-form-application-id-index"
               author="adruida">

        <preConditions onFail="MARK_RAN">

            <tableExists
                    tableName="application_forms"
                    schemaName="${schemaName}"/>

            <columnExists
                    tableName="application_forms"
                    schemaName="${schemaName}"
                    columnName="application_id"/>

            <not>
                <indexExists
                        tableName="application_forms"
                        schemaName="${schemaName}"
                        indexName="idx_app_forms_application_id"/>
            </not>

        </preConditions>

        <createIndex
                tableName="application_forms"
                schemaName="${schemaName}"
                indexName="idx_app_forms_application_id">

            <column name="application_id"/>

        </createIndex>

    </changeSet>

    <!-- ================================================================= -->
    <!-- CHANGESET 5 - INDEX position                                      -->
    <!-- ================================================================= -->

    <changeSet id="5-create-app-form-position-index"
               author="adruida">

        <preConditions onFail="MARK_RAN">

            <tableExists
                    tableName="application_forms"
                    schemaName="${schemaName}"/>

            <columnExists
                    tableName="application_forms"
                    schemaName="${schemaName}"
                    columnName="position"/>

            <not>
                <indexExists
                        tableName="application_forms"
                        schemaName="${schemaName}"
                        indexName="idx_app_forms_position"/>
            </not>

        </preConditions>

        <createIndex
                tableName="application_forms"
                schemaName="${schemaName}"
                indexName="idx_app_forms_position">

            <column name="position"/>

        </createIndex>

    </changeSet>

</databaseChangeLog>